{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "GEO: Conversational Agent + Inspector",
      "type": "debugpy",
      "request": "attach",
      "connect": { "host": "127.0.0.1", "port": 5679 },
      "preLaunchTask": "GEO: Open Agent Inspector",
      "justMyCode": true
    },
    {
      "name": "GEO: Conversational Agent Server",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/geo-agent/.venv/Scripts/python.exe",
      "module": "geo_agent",
      "cwd": "${workspaceFolder}",
      "env": {
        "GEO_CHAT_POLICY": "${workspaceFolder}/geo-agent/chat-policy.json",
        "GEO_LIVE_POLICY": "${workspaceFolder}/geo-agent/live-policy.json",
        "GEO_BUDGET_GRANT": "${workspaceFolder}/geo-agent/budget-grant.json",
        "GEO_ANALYSIS_POLICY": "${workspaceFolder}/geo-agent/analysis-policy.json",
        "GEO_MEASUREMENT_POLICY": "${workspaceFolder}/geo-agent/measurement-live-policy-v2.json",
        "GEO_PORT": "8090",
        "GEO_DATA_DIR": "${workspaceFolder}/geo-agent/.data"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "GEO: Live Measurement Worker",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/geo-agent/.venv/Scripts/python.exe",
      "module": "geo_agent.measurement_worker",
      "cwd": "${workspaceFolder}",
      "env": {
        "GEO_MEASUREMENT_POLICY": "${workspaceFolder}/geo-agent/measurement-live-policy-v2.json",
        "GEO_MEASUREMENT_BUDGET_GRANT": "${workspaceFolder}/geo-agent/measurement-live-budget-grant-10-runs.json",
        "GEO_DATA_DIR": "${workspaceFolder}/geo-agent/.data"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    },
    {
      "name": "GEO: Next.js Web",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/web"
    }
  ],
  "compounds": [
    {
      "name": "GEO: Full Live Workspace",
      "configurations": [
        "GEO: Conversational Agent Server",
        "GEO: Live Measurement Worker",
        "GEO: Next.js Web"
      ],
      "stopAll": true
    }
  ]
}