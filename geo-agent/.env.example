# The launcher loads geo-agent/.env. Existing environment variables take precedence.
# Keep real keys in .env, never in this example or source control.
GEO_PORT=8088
# GEO_DATA_DIR defaults to geo-agent/.data, independent of the working directory.
# GEO_API_TOKEN must contain at least 32 characters if set.
# Without it, the launcher generates a local token in .data/local-api-token.

# Local MCP identity. Stdio receives identity from its process environment.
GEO_MCP_TENANT_ID=local-development
GEO_MCP_OWNER=local-developer
GEO_MCP_PRINCIPAL_ID=local-agent
GEO_HUMAN_BASE_URL=http://127.0.0.1:8088
# Optional loopback Streamable HTTP. Use a different 32+ character token from
# GEO_API_TOKEN. Agent credentials are rejected by human-only REST routes.
# GEO_MCP_AGENT_TOKEN=
# Live MCP remains disabled unless remote identity, grant admission and canary
# gates are separately approved and this opt-in is set deliberately.
# GEO_MCP_ALLOW_LIVE=false

# Documented Web IQ v3 endpoints; both use POST and the x-apikey header.
# Live calls also require an explicit approved GEO_LIVE_POLICY file.
WEBIQ_BROWSE_ENDPOINT=https://api.microsoft.ai/v3/browse
WEBIQ_SEARCH_ENDPOINT=https://api.microsoft.ai/v3/search/web
WEBIQ_API_KEY=

# Direct Foundry OpenAI resource base URL, ending /openai/v1/.
# Authentication uses your Azure CLI Entra sign-in; no Foundry API key is needed.
AZURE_OPENAI_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=

# Primary measurement query planner. The stable endpoint identifies the agent;
# every request pins the configured immutable version through agent_reference.
# URL, locale, audience and goal are sent from the approved measurement brief.
GEO_QUERY_AGENT_ENDPOINT=https://hackathon-2026-geo-optimiser.services.ai.azure.com/api/projects/proj-default/agents/MissionsAndMoments/endpoint/protocols/openai/responses
GEO_QUERY_AGENT_VERSION=7

# Shared hosted agent for current and future projects. Leave all three blank to disable.
# The full Responses endpoint identifies the resource/project/name; version is pinned per request.
# Model deployment and knowledge base are not required for a tool-free hosted agent.
GEO_FOUNDRY_AGENT_ENDPOINT=
GEO_FOUNDRY_AGENT_NAME=
GEO_FOUNDRY_AGENT_VERSION=
# One response per explicit user message, max 512,000 input bytes,
# max 2,000 output tokens, tools disabled, no retries.
# Azure service quota and consumption remain external platform controls.

# Optional Recommendations specialist agent. Leave all three blank to use the
# existing direct model recommendation provider. A configured agent is pinned
# for the stage and does not silently fall back after an invocation failure.
GEO_FOUNDRY_RECOMMENDATIONS_AGENT_ENDPOINT=
GEO_FOUNDRY_RECOMMENDATIONS_AGENT_NAME=
GEO_FOUNDRY_RECOMMENDATIONS_AGENT_VERSION=

# Reserved role naming for future specialist providers. These roles continue
# using their existing application providers until their agent adapters ship.
# GEO_FOUNDRY_GROUNDING_QUERY_AGENT_ENDPOINT=
# GEO_FOUNDRY_GROUNDING_QUERY_AGENT_NAME=
# GEO_FOUNDRY_GROUNDING_QUERY_AGENT_VERSION=
# GEO_FOUNDRY_LLM_SURVEY_AGENT_ENDPOINT=
# GEO_FOUNDRY_LLM_SURVEY_AGENT_NAME=
# GEO_FOUNDRY_LLM_SURVEY_AGENT_VERSION=
# Compatibility fallback: AZURE_AI_PROJECT_ENDPOINT may contain a direct
# /openai/v1/ or /openai/v1/responses URL, not an /api/projects/... URL.
# Explicit opt-in, normally set to an absolute path in the launch environment:
# GEO_LIVE_POLICY=C:/path/to/geo-agent/live-policy.json
# The checked-in Daylesford policy's first-test budget has already been consumed.

# Project measurements are live-only. The API and worker must use the same policy.
# The local compatibility grant is retained for immutable historical accounting,
# but the current project workflow does not enforce a lifetime run ceiling.
# GEO_MEASUREMENT_POLICY=C:/path/to/live-measurement-policy.json
# GEO_MEASUREMENT_BUDGET_GRANT=C:/path/to/live-measurement-budget-grant-10-runs.json
# Optional historical grants, supplied as an OS path-separated list or JSON array:
# GEO_MEASUREMENT_ADDITIONAL_BUDGET_GRANTS=C:/path/to/additional-grant.json
# GEO_MEASUREMENT_WORKER_ID=local-live-worker
# GEO_MEASUREMENT_WORKER_POLL_SECONDS=1

# Separate opt-in for the read-only Agent Framework conversational agent.
# Set in the launch environment, not needed for the synthetic backend:
# GEO_CHAT_POLICY=C:/path/to/geo-agent/chat-policy.json
# Chat policy is separate from the exhausted live-evaluation policy.
# Additional approved capacity is loaded idempotently from a separate grant.
# Both GEO_CHAT_POLICY and GEO_LIVE_POLICY must be set when enabling it:
# GEO_BUDGET_GRANT=C:/path/to/geo-agent/budget-grant.json
# Current grant: 30 extra chat requests and 10 extra five-query Daylesford runs.

# Separate public-URL analysis allowance; no changes to older chat/live budgets.
# GEO_ANALYSIS_POLICY=C:/path/to/geo-agent/analysis-policy.json
# Approved: 10 page analyses and up to 10 optional citation evaluations.
# Each analysis: 1 indexed Browse + 1 Foundry call. No automatic retries.
# Each optional evaluation: 1 query proposal + 5 Searches + 5 evaluator calls.
# Exact query approval is required before the searches and answer calls.
